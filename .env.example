# Supabase — copie para .env e preencha com os valores do seu projeto.
# A chave publishable é pública por natureza (protegida por RLS), mas mesmo
# assim o .env não deve ser versionado — ver .gitignore.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Chave pública VAPID usada pelo navegador para criar a assinatura Web Push.
# A chave privada correspondente deve existir somente no secret VAPID_PRIVATE_KEY
# da Edge Function.
VITE_VAPID_PUBLIC_KEY=
