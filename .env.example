# Supabase — copie para .env e preencha com os valores do seu projeto.
# A chave publishable é pública por natureza (protegida por RLS), mas mesmo
# assim o .env não deve ser versionado — ver .gitignore.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# URL publica estavel usada em confirmacao, recuperacao de senha e links que
# tambem precisam funcionar quando a interface estiver no aplicativo nativo.
VITE_PUBLIC_APP_URL=https://multierp.multisoluction.com.br

# Deep link nativo opcional. Manter vazio ate App Links/Universal Links serem
# configurados e autorizados no Supabase.
VITE_NATIVE_AUTH_REDIRECT_URL=

# Chave pública VAPID usada pelo navegador para criar a assinatura Web Push.
# A chave privada correspondente deve existir somente no secret VAPID_PRIVATE_KEY
# da Edge Function.
VITE_VAPID_PUBLIC_KEY=
